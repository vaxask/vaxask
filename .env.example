# --- LLM (OpenAI-compatible endpoint; defaults to DeepSeek) ---
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Responder model (generates the answer). Reasoning/thinking is disabled in code.
RESPONDER_MODEL=deepseek-chat
RESPONDER_TEMPERATURE=0.3

# Classifier model (labels the question: category / attitude / emotion / red-flag / audience)
CLASSIFIER_MODEL=deepseek-chat
CLASSIFIER_TEMPERATURE=0.3
CLASSIFIER_ATTEMPTS=6

# --- Storage ---
CHROMA_DB_PATH=./chroma_db
PDF_STORAGE_PATH=./pdfs
# 0 = no per-document chunk limit
MAX_CHUNKS_PER_DOC=0

# --- Admin panel (knowledge-base management) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
